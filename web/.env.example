# Copy to .env.local for development.
API_ORIGIN=http://127.0.0.1:8000
# dev only (APP_ENV=dev, DEV_AUTH=true in backend): token printed by `python -m voiceos.seed`
DEV_AUTH_TOKEN=dev:00000000-0000-4000-8000-0000000000a1
NEXT_PUBLIC_GATEWAY_URL=http://127.0.0.1:8100

# OIDC sign-in (ADR 0008). Leave OIDC_ISSUER empty to keep using DEV_AUTH_TOKEN.
# Local test provider: `node scripts/mock-oidc.mjs` -> OIDC_ISSUER=http://localhost:9400, any client id.
OIDC_ISSUER=
OIDC_CLIENT_ID=voiceos-web
OIDC_CLIENT_SECRET=
# at least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
