# Copy to .env and fill locally. Never commit .env.

APP_ENV=dev
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# backend (api + worker)
DATABASE_URL=sqlite+pysqlite:///./voiceos-dev.db
# DATABASE_URL=postgresql+psycopg://voiceos:voiceos@localhost:5432/voiceos
REDIS_URL=redis://localhost:6379/0
# dev-only bearer "dev:<user_id>"; must be false outside APP_ENV=dev
DEV_AUTH=true

# safety switches (docs/09)
CALL_PROVIDER=mock
CONNECTOR_MODE=mock
NOTIFY_PROVIDER=mock
OUTBOUND_ENABLED=false

# media gateway / voice spike
AI_PROVIDER=mock            # default provider: mock | gemini | openai (spike page can pick per call)
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100

# Gemini Live (ADR 0003)
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-live
AI_VOICE=                   # optional prebuilt voice name, empty = provider default

# OpenAI Realtime (ADR 0005)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_VOICE=marin          # marin | cedar recommended; cannot change mid-call
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_VAD=server_vad       # server_vad | semantic_vad

# optional, for cost estimate in spike reports only (USD per 1M tokens). Leave empty if unverified.
GEMINI_PRICE_AUDIO_IN_PER_MTOK=
GEMINI_PRICE_AUDIO_OUT_PER_MTOK=
GEMINI_PRICE_TEXT_IN_PER_MTOK=
GEMINI_PRICE_TEXT_OUT_PER_MTOK=
OPENAI_PRICE_AUDIO_IN_PER_MTOK=
OPENAI_PRICE_AUDIO_OUT_PER_MTOK=
OPENAI_PRICE_TEXT_IN_PER_MTOK=
OPENAI_PRICE_TEXT_OUT_PER_MTOK=
USD_TO_VND=
