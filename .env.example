# Copy to .env and fill locally. Never commit .env.

APP_ENV=dev
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# backend (api + worker)
DATABASE_URL=sqlite+pysqlite:///./voiceos-dev.db
# DATABASE_URL=postgresql+psycopg://voiceos:voiceos@localhost:5432/voiceos
REDIS_URL=redis://localhost:6379/0
# dev-only bearer "dev:<user_id>"; must be false outside APP_ENV=dev
DEV_AUTH=true

# safety switches (docs/09)
CALL_PROVIDER=mock
CONNECTOR_MODE=mock
NOTIFY_PROVIDER=mock
OUTBOUND_ENABLED=false

# media gateway / voice spike
AI_PROVIDER=mock            # mock | gemini
AI_MODEL=gemini-3.8-live
AI_VOICE=                   # optional prebuilt voice name, empty = provider default
GEMINI_API_KEY=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8100
# optional, for cost estimate in spike reports only (USD per 1M tokens). Leave empty if unverified.
PRICE_AUDIO_IN_PER_MTOK=
PRICE_AUDIO_OUT_PER_MTOK=
PRICE_TEXT_IN_PER_MTOK=
PRICE_TEXT_OUT_PER_MTOK=
USD_TO_VND=
